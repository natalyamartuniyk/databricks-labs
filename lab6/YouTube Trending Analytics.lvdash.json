    {
      "name": "f8fbd5d4",
      "displayName": "trending_videos",
      "queryLines": [
        "SELECT\n",
        "    d.full_date,\n",
        "    c.category_name,\n",
        "    ch.channel_title,\n",
        "    v.video_id,\n",
        "    v.title,\n",
        "    f.views,\n",
        "    f.likes,\n",
        "    f.views_delta,\n",
        "    f.trending_day_num\n",
        "FROM dbr_dev_ua5816bd.natalkamartinuk55_gold.fact_video_daily_stats AS f\n",
        "JOIN dbr_dev_ua5816bd.natalkamartinuk55_gold.dim_date     AS d  ON f.date_key    = d.date_key\n",
        "JOIN dbr_dev_ua5816bd.natalkamartinuk55_gold.dim_category AS c  ON f.category_id = c.category_id\n",
        "JOIN dbr_dev_ua5816bd.natalkamartinuk55_gold.dim_channel  AS ch ON f.channel_key = ch.channel_key\n",
        "JOIN dbr_dev_ua5816bd.natalkamartinuk55_gold.dim_video    AS v  ON f.video_id    = v.video_id"
      ],
      "columns": [
        {
          "displayName": "like_rate",
          "description": "",
          "expression": "SUM(likes) / SUM(views)"
        }
      ]
    },
    {
      "name": "1bfabd29",
      "displayName": "top_channels",
      "queryLines": [
        "WITH per_video AS (\n",
        "    SELECT f.channel_key, f.video_id, MAX(f.views) AS peak_views\n",
        "    FROM dbr_dev_ua5816bd.natalkamartinuk55_gold.fact_video_daily_stats AS f\n",
        "    JOIN dbr_dev_ua5816bd.natalkamartinuk55_gold.dim_date     AS d ON f.date_key    = d.date_key\n",
        "    JOIN dbr_dev_ua5816bd.natalkamartinuk55_gold.dim_category AS c ON f.category_id = c.category_id\n",
        "    WHERE d.full_date BETWEEN :period.min AND :period.max\n",
        "            AND (:category IS NULL OR size(:category) <= 0 OR ARRAY_CONTAINS(:category, c.category_name))\n",
        "    GROUP BY f.channel_key, f.video_id\n",
        ")\n",
        "SELECT ch.channel_title, SUM(p.peak_views) AS total_views\n",
        "FROM per_video AS p\n",
        "JOIN dbr_dev_ua5816bd.natalkamartinuk55_gold.dim_channel AS ch ON p.channel_key = ch.channel_key\n",
        "GROUP BY ch.channel_title\n",
        "ORDER BY total_views DESC\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "period",
          "keyword": "period",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2017-11-14T00:00:00.000"
              },
              "max": {
                "value": "2018-06-14T23:59:59.999"
              }
            }
          }
        },
        {
          "displayName": "category",
          "keyword": "category",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        }
      ]
    },
    {
      "name": "7f8cd1fa",
      "displayName": "category_share",
      "queryLines": [
        "WITH top5 AS (\n",
        "    SELECT category_name\n",
        "    FROM dbr_dev_ua5816bd.natalkamartinuk55_gold.agg_category_daily\n",
        "    GROUP BY category_name\n",
        "    ORDER BY SUM(views_gained) DESC\n",
        "    LIMIT 5\n",
        ")\n",
        "SELECT\n",
        "    a.full_date,\n",
        "    a.category_name,\n",
        "    CASE WHEN t.category_name IS NOT NULL THEN a.category_name ELSE 'Other' END AS category_group,\n",
        "    a.views_gained\n",
        "FROM dbr_dev_ua5816bd.natalkamartinuk55_gold.agg_category_daily AS a\n",
        "LEFT JOIN top5 AS t ON a.category_name = t.category_name"
      ]
    }
  ],
